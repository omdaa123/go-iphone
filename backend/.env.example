# Local development only. Never commit a real .env file.
NODE_ENV=development
PORT=4000
ENABLE_ADMIN_WRITES=false
ENABLE_COMMERCE_WRITES=false
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_SSL=true
# Production migrations are blocked unless explicitly enabled for a one-off manual run.
# Back up and verify the target database before setting this to true.
ALLOW_PRODUCTION_MIGRATIONS=false
ALLOW_PRODUCTION_SEED=false
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
COOKIE_SECURE=false
# Local testing only. Production should leave this unset (2FA is required by default).
REQUIRE_2FA=false
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_AT_LEAST_12_CHARACTERS
LOCAL_UPLOAD_DIR=./uploads
LOCAL_UPLOAD_PUBLIC_URL=http://127.0.0.1:4000/uploads

# Primary persistent media storage for Production: configure these in Render.
# ImageKit is the selected provider. Keep the private key server-side only.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=go-iphone

# Optional alternatives only; not required when ImageKit is configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=go-iphone

# Alternative S3-compatible storage (e.g. Cloudflare R2):
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_KEY_PREFIX=uploads
S3_FORCE_PATH_STYLE=true
