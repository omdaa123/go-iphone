# Optional direct API override. Leave unset in production to use the same-origin Vercel rewrite.
# For local development, the app defaults to http://localhost:4000 (or the Vite proxy in admin preview).
# VITE_API_URL=http://127.0.0.1:4000

# Vite development proxy target; keep this pointed at the local backend.
API_ORIGIN=http://127.0.0.1:4000
